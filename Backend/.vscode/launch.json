
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug React Frontend",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/Frontend"
        },
        {
            "name": "Debug Node Backend",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
